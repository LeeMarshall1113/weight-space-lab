/-
Lane 4, rung 9-LN15 (PREREG_R9LN15.md): the network model. A one-block softmax transformer of the
rung-8 kind (Lane4/AGate.lean) with three LayerNorms in the pre-LN places, under ADDITIVE weight
perturbation, in the rounding model of Lane4/RSoft.lean.

Fixed by the lane before the first kit case. Doctors do not edit this file.
The executable version of the operation order is `run` and `lnorm` in tools/r9ln.py.

    h_j = LN1(x_j)                              x_j = stored embedding row of the token at j
    y_i = x_i + Σ_heads attention(h)(i)         scores, gates, keys and values read h
    z_i = y_i + W2 · relu(W1 · LN2(y_i) + b1) + b2
    out = oW · LNf(z_i) + oB

LayerNorm of a vector `x` of length `n`, every operation rounded:
    mean = fl (rsum x / n)                      left-to-right rounded sum
    c_k  = fl (x_k - mean)
    s    = sq (fl (fl (rsum (fl (c_k * c_k)) / n) + fl (1/100000)))
    out_k = fl (fl (fl (c_k / s) * g'_k) + b'_k)        g', b' stored gain and bias (`asw`)

`sq` is the floating-point square root; `SqrtM` is the assumption made about it (binary32 square
root is correctly rounded, which gives `SqrtM` with `u = 2^-24`). With `fl = id` and
`sq = Real.sqrt` this is exact arithmetic.
-/
import Lane4.R8All

namespace Lane4.LN

open Lane4.Seq (Mask cand tokAt)
open Lane4.RSeq (Vec pdot radd rsum)
open Lane4.RSoft Lane4.AGate

/-- The model of the float square root. -/
structure SqrtM (u η : ℝ) (sq : ℝ → ℝ) : Prop where
  err : ∀ x, 0 ≤ x → |sq x - Real.sqrt x| ≤ u * Real.sqrt x + η

/-- gain and bias: entry `k, k+1, ...` -/
noncomputable def lnScale (fl : ℝ → ℝ) (s : ℝ) :
    Vec → List ℚ → List ℚ → (ℕ → ℝ) → (ℕ → ℝ) → ℕ → Vec
  | c :: cs, g :: gs, b :: bs, dg, db, k =>
    fl (fl (fl (c / s) * asw fl g (dg k)) + asw fl b (db k)) :: lnScale fl s cs gs bs dg db (k + 1)
  | _, _, _, _, _, _ => []

/-- the centred vector -/
noncomputable def lnCentre (fl : ℝ → ℝ) (x : Vec) : Vec :=
  x.map (fun v => fl (v - fl (rsum fl x 0 / (x.length : ℝ))))

/-- the rounded standard deviation of a centred vector `c` -/
noncomputable def lnSigma (fl sq : ℝ → ℝ) (c : Vec) : ℝ :=
  sq (fl (fl (rsum fl (c.map (fun v => fl (v * v))) 0 / (c.length : ℝ)) + fl (1 / 100000)))

/-- LayerNorm with written gains `g` and biases `b`, perturbed by `dg`, `db`. -/
noncomputable def lnorm (fl sq : ℝ → ℝ) (g b : List ℚ) (dg db : ℕ → ℝ) (x : Vec) : Vec :=
  lnScale fl (lnSigma fl sq (lnCentre fl x)) (lnCentre fl x) g b dg db 0

/-- The written network: a rung-8 network with exactly one block, and three LayerNorms. -/
structure LNNet where
  net : ANet
  g1 : List ℚ
  b1 : List ℚ
  g2 : List ℚ
  b2 : List ℚ
  gf : List ℚ
  bf : List ℚ

/-- One additive perturbation per weight, LayerNorm gains and biases included. -/
structure LPert where
  a : APert
  g1 : ℕ → ℝ
  b1 : ℕ → ℝ
  g2 : ℕ → ℝ
  b2 : ℕ → ℝ
  gf : ℕ → ℝ
  bf : ℕ → ℝ

structure LPert.Within (δ : ℝ) (p : LPert) : Prop where
  a : p.a.Within δ
  g1 : ∀ k, |p.g1 k| ≤ δ
  b1 : ∀ k, |p.b1 k| ≤ δ
  g2 : ∀ k, |p.g2 k| ≤ δ
  b2 : ∀ k, |p.b2 k| ≤ δ
  gf : ∀ k, |p.gf k| ≤ δ
  bf : ∀ k, |p.bf k| ≤ δ

/-- what the heads read at position `j`: LN1 of the stored embedding row -/
noncomputable def LNNet.hid (N : LNNet) (fl sq : ℝ → ℝ) (p : LPert) (w : List ℕ) : ℕ → Vec :=
  fun j => lnorm fl sq N.g1 N.b1 p.g1 p.b1 (N.net.init fl p.a w j)

/-- the residual stream after the heads at position `i` -/
noncomputable def LNNet.mid (N : LNNet) (B : ABlock) (fl ex sq : ℝ → ℝ) (p : LPert) (w : List ℕ)
    (i : ℕ) : Vec :=
  aheadsApply fl ex p.a 0 (w.length + 1) (N.hid fl sq p w) i B.heads (N.net.init fl p.a w i) 0

/-- the residual stream after the MLP, given the stream `y` after the heads -/
noncomputable def LNNet.post (N : LNNet) (B : ABlock) (fl sq : ℝ → ℝ) (p : LPert) (y : Vec) : Vec :=
  radd fl y
    (araffine fl B.W2 B.b2
      ((araffine fl B.W1 B.b1 (lnorm fl sq N.g2 N.b2 p.g2 p.b2 y) (p.a.W1 0) (p.a.b1 0) 0).map
        Lane4.relu)
      (p.a.W2 0) (p.a.b2 0) 0)

/-- the read-out of the stream `z` after the MLP -/
noncomputable def LNNet.read (N : LNNet) (fl sq : ℝ → ℝ) (p : LPert) (z : Vec) : ℝ :=
  fl (ardot fl N.net.outW (lnorm fl sq N.gf N.bf p.gf p.bf z) p.a.oW 0 0 + asw fl N.net.outB p.a.oB)

/-- The network's output at position `i` for input `w` (0 unless there is exactly one block). -/
noncomputable def LNNet.out (N : LNNet) (fl ex sq : ℝ → ℝ) (p : LPert) (w : List ℕ) (i : ℕ) : ℝ :=
  match N.net.blocks with
  | [B] => N.read fl sq p (N.post B fl sq p (N.mid B fl ex sq p w i))
  | _ => 0

end Lane4.LN
