/-
Lane 4, rung 6a framework: a softmax transformer with a GATED candidate set and a
RELATIVE-POSITION score bias, under ADDITIVE weight perturbation, in the floating-point
model of RSoft.lean.

Fixed by the lane. Doctors do not edit this file. Design notes: R6A_DESIGN.md.

What changes against RSoft.lean (rung 5):

* The state at a position is the stored embedding row of its token and nothing else.
  There are NO position coordinates in the state.
* Positions enter only through a score bias: `fl (m' * (j - i))` with one scalar slope
  `m` per head (`m'` its stored value), for query position `i` and key position `j`.
* Each head has a gate neuron on the keys: `gate j = relu (fl (g' · x_j + gb'))`.
  Key `j` is a candidate for query `i` iff the mask allows it and `gate j = 0` exactly.
* The perturbation is ADDITIVE: a written weight `w` is used as `asw fl w d = fl (w + d)`,
  with one `d` per weight: embedding entries, score and value matrices, slopes, gate
  weights and gate biases, MLP weights and biases, read-out weights and bias. A weight
  written as 0 does NOT stay 0.
* Everything else is as in RSoft.lean: the rounding model `Rnd u η M fl`, the exponential
  hypothesis `ExpM u η ex`, softmax in the stated order (`savg`), residual heads, a
  one-hidden-layer ReLU MLP per block, a linear read-out. With no candidate the head's
  output is 0.
-/
import Lane4.RSoftKit

namespace Lane4.AGate

open Lane4.Seq (Mask cand tokAt)
open Lane4.RSeq (Vec pdot radd)
open Lane4.RSoft

/-- One additive perturbation per weight. -/
structure APert where
  E : ℕ → ℕ → ℝ
  A : ℕ → ℕ → ℕ → ℕ → ℝ
  V : ℕ → ℕ → ℕ → ℕ → ℝ
  m : ℕ → ℕ → ℝ
  g : ℕ → ℕ → ℕ → ℝ
  gb : ℕ → ℕ → ℝ
  W1 : ℕ → ℕ → ℕ → ℝ
  b1 : ℕ → ℕ → ℝ
  W2 : ℕ → ℕ → ℕ → ℝ
  b2 : ℕ → ℕ → ℝ
  oW : ℕ → ℝ
  oB : ℝ

/-- Every perturbation is at most `δ` in absolute value. -/
structure APert.Within (δ : ℝ) (p : APert) : Prop where
  E : ∀ t c, |p.E t c| ≤ δ
  A : ∀ b h r c, |p.A b h r c| ≤ δ
  V : ∀ b h r c, |p.V b h r c| ≤ δ
  m : ∀ b h, |p.m b h| ≤ δ
  g : ∀ b h c, |p.g b h c| ≤ δ
  gb : ∀ b h, |p.gb b h| ≤ δ
  W1 : ∀ b r c, |p.W1 b r c| ≤ δ
  b1 : ∀ b r, |p.b1 b r| ≤ δ
  W2 : ∀ b r c, |p.W2 b r c| ≤ δ
  b2 : ∀ b r, |p.b2 b r| ≤ δ
  oW : ∀ c, |p.oW c| ≤ δ
  oB : |p.oB| ≤ δ

/-- The stored weight: written `w`, moved by `d`, rounded. -/
noncomputable def asw (fl : ℝ → ℝ) (w : ℚ) (d : ℝ) : ℝ := fl ((w : ℝ) + d)

noncomputable def aswRow (fl : ℝ → ℝ) : List ℚ → (ℕ → ℝ) → ℕ → Vec
  | a :: w, d, j => asw fl a (d j) :: aswRow fl w d (j + 1)
  | [], _, _ => []

/-- Rounded dot product of a stored weight row with a vector: left to right from `acc`. -/
noncomputable def ardot (fl : ℝ → ℝ) : List ℚ → Vec → (ℕ → ℝ) → ℕ → ℝ → ℝ
  | a :: w, v :: x, d, j, acc => ardot fl w x d (j + 1) (fl (acc + fl (asw fl a (d j) * v)))
  | _, _, _, _, acc => acc

noncomputable def armat (fl : ℝ → ℝ) : List (List ℚ) → Vec → (ℕ → ℕ → ℝ) → ℕ → Vec
  | r :: M, x, d, i => ardot fl r x (d i) 0 0 :: armat fl M x d (i + 1)
  | [], _, _, _ => []

noncomputable def araffine (fl : ℝ → ℝ) :
    List (List ℚ) → List ℚ → Vec → (ℕ → ℕ → ℝ) → (ℕ → ℝ) → ℕ → Vec
  | r :: M, c :: b, x, dW, db, i =>
    fl (ardot fl r x (dW i) 0 0 + asw fl c (db i)) :: araffine fl M b x dW db (i + 1)
  | _, _, _, _, _, _ => []

structure AHead where
  A : List (List ℚ)
  V : List (List ℚ)
  mask : Mask
  /-- slope of the relative-position score bias -/
  m : ℚ
  /-- gate neuron on the keys: weights and bias -/
  g : List ℚ
  gb : ℚ

/-- The gate of key state `xj`: the key is a candidate iff this is exactly 0. -/
noncomputable def AHead.gate (h : AHead) (fl : ℝ → ℝ) (dg : ℕ → ℝ) (dgb : ℝ) (xj : Vec) : ℝ :=
  Lane4.relu (fl (ardot fl h.g xj dg 0 0 + asw fl h.gb dgb))

/-- The candidate keys of query `i`: allowed by the mask and with gate exactly 0. -/
noncomputable def AHead.cands (h : AHead) (fl : ℝ → ℝ) (dg : ℕ → ℝ) (dgb : ℝ) (n : ℕ)
    (x : ℕ → Vec) (i : ℕ) : List ℕ :=
  (cand h.mask n i).filter (fun j => decide (h.gate fl dg dgb (x j) = 0))

/-- The position bias of key `j` for query `i`: stored slope times `j - i`. -/
noncomputable def AHead.bias (h : AHead) (fl : ℝ → ℝ) (dm : ℝ) (i j : ℕ) : ℝ :=
  fl (asw fl h.m dm * (((j : ℤ) - (i : ℤ) : ℤ) : ℝ))

/-- The score of key `j` for query `i`: position bias plus a bilinear content term. -/
noncomputable def AHead.score (h : AHead) (fl : ℝ → ℝ) (dA : ℕ → ℕ → ℝ) (dm : ℝ)
    (x : ℕ → Vec) (i j : ℕ) : ℝ :=
  fl (h.bias fl dm i j + pdot fl (x i) (armat fl h.A (x j) dA 0) 0)

/-- One output entry per row of `V`: the softmax average of `V_r · x_j` over candidates. -/
noncomputable def aattnRows (fl ex : ℝ → ℝ) :
    List (List ℚ) → (ℕ → ℕ → ℝ) → List ℕ → (ℕ → ℝ) → (ℕ → Vec) → ℕ → Vec
  | r :: M, dV, c, s, x, i =>
    savg fl ex c s (fun j => ardot fl r (x j) (dV i) 0 0) :: aattnRows fl ex M dV c s x (i + 1)
  | [], _, _, _, _, _ => []

noncomputable def AHead.attn (h : AHead) (fl ex : ℝ → ℝ) (dA dV : ℕ → ℕ → ℝ) (dm : ℝ)
    (dg : ℕ → ℝ) (dgb : ℝ) (n : ℕ) (x : ℕ → Vec) (i : ℕ) : Vec :=
  aattnRows fl ex h.V dV (h.cands fl dg dgb n x i) (fun j => h.score fl dA dm x i j) x 0

structure ABlock where
  heads : List AHead
  W1 : List (List ℚ)
  b1 : List ℚ
  W2 : List (List ℚ)
  b2 : List ℚ

/-- Heads `k, k+1, ...` of block `b` added to `acc` (all read the block's input state). -/
noncomputable def aheadsApply (fl ex : ℝ → ℝ) (p : APert) (b n : ℕ) (x : ℕ → Vec) (i : ℕ) :
    List AHead → Vec → ℕ → Vec
  | h :: hs, acc, k =>
    aheadsApply fl ex p b n x i hs
      (radd fl acc (h.attn fl ex (p.A b k) (p.V b k) (p.m b k) (p.g b k) (p.gb b k) n x i)) (k + 1)
  | [], acc, _ => acc

noncomputable def ABlock.apply (B : ABlock) (fl ex : ℝ → ℝ) (p : APert) (b n : ℕ)
    (x : ℕ → Vec) : ℕ → Vec := fun i =>
  radd fl (aheadsApply fl ex p b n x i B.heads (x i) 0)
    (araffine fl B.W2 B.b2
      ((araffine fl B.W1 B.b1 (aheadsApply fl ex p b n x i B.heads (x i) 0)
        (p.W1 b) (p.b1 b) 0).map Lane4.relu)
      (p.W2 b) (p.b2 b) 0)

structure ANet where
  embed : List (List ℚ)
  blocks : List ABlock
  outW : List ℚ
  outB : ℚ

/-- The starting state: the stored embedding row of the token (no position features). -/
noncomputable def ANet.init (N : ANet) (fl : ℝ → ℝ) (p : APert) (w : List ℕ) : ℕ → Vec :=
  fun i => aswRow fl (N.embed.getD (tokAt w i) []) (p.E (tokAt w i)) 0

noncomputable def arunFrom (fl ex : ℝ → ℝ) (p : APert) (n : ℕ) :
    List ABlock → ℕ → (ℕ → Vec) → (ℕ → Vec)
  | B :: Bs, b, x => arunFrom fl ex p n Bs (b + 1) (B.apply fl ex p b n x)
  | [], _, x => x

noncomputable def ANet.run (N : ANet) (fl ex : ℝ → ℝ) (p : APert) (w : List ℕ) : ℕ → Vec :=
  arunFrom fl ex p (w.length + 1) N.blocks 0 (N.init fl p w)

/-- The network's output at position `i` for input `w`. -/
noncomputable def ANet.out (N : ANet) (fl ex : ℝ → ℝ) (p : APert) (w : List ℕ) (i : ℕ) : ℝ :=
  fl (ardot fl N.outW (N.run fl ex p w i) p.oW 0 0 + asw fl N.outB p.oB)

/-! ### Shape check -/

def rowsOK (M : List (List ℚ)) (rows cols : ℕ) : Bool :=
  M.length == rows && M.all (fun r => r.length == cols)

def AHead.shapeOK (h : AHead) (d : ℕ) : Bool :=
  rowsOK h.A d d && rowsOK h.V d d && h.g.length == d

def ABlock.shapeOK (B : ABlock) (d : ℕ) : Bool :=
  decide (B.heads.length ≤ 4) && B.heads.all (fun h => h.shapeOK d) &&
  decide (B.b1.length ≤ 32) && rowsOK B.W1 B.b1.length d &&
  rowsOK B.W2 d B.b1.length && B.b2.length == d

/-- `ntok` real tokens (so `ntok + 1` embedding rows), state width `d ≤ 24`, at most
4 blocks of at most 4 heads. -/
def ANet.shapeOK (N : ANet) (ntok : ℕ) : Bool :=
  match N.embed with
  | [] => false
  | e :: _ =>
    decide (e.length ≤ 24) && rowsOK N.embed (ntok + 1) e.length &&
    decide (N.blocks.length ≤ 4) && N.blocks.all (fun B => B.shapeOK e.length) &&
    N.outW.length == e.length

/-! ### Lemma kit: stored weights under additive perturbation -/

/-- A stored weight is within `δ + u * (|w| + δ) + η` of the written weight.
Range condition: `|w| + δ ≤ M`. -/
theorem asw_near {u η M δ : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) (hu : 0 ≤ u) (w : ℚ) {d : ℝ}
    (hd : |d| ≤ δ) (hM : |(w : ℝ)| + δ ≤ M) :
    |asw fl w d - (w : ℝ)| ≤ δ + (u * (|(w : ℝ)| + δ) + η) := by
  unfold asw
  have h1 : |(w : ℝ) + d| ≤ |(w : ℝ)| + δ := le_trans (abs_add_le _ _) (by linarith)
  have h2 := h.abs hu h1 hM
  have h3 := abs_add_le (fl ((w : ℝ) + d) - ((w : ℝ) + d)) d
  have h4 : fl ((w : ℝ) + d) - ((w : ℝ) + d) + d = fl ((w : ℝ) + d) - (w : ℝ) := by ring
  rw [h4] at h3
  linarith

/-- A bound on a stored weight. -/
theorem asw_bound {u η M δ : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) (hu : 0 ≤ u) (w : ℚ) {d : ℝ}
    (hd : |d| ≤ δ) (hM : |(w : ℝ)| + δ ≤ M) :
    |asw fl w d| ≤ |(w : ℝ)| + δ + (u * (|(w : ℝ)| + δ) + η) := by
  unfold asw
  have h1 : |(w : ℝ) + d| ≤ |(w : ℝ)| + δ := le_trans (abs_add_le _ _) (by linarith)
  exact h.bound hu h1 hM

/-- A stored weight is unchanged by rounding it again. -/
theorem fl_asw {u η M δ : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) (w : ℚ) {d : ℝ}
    (hd : |d| ≤ δ) (hM : |(w : ℝ)| + δ ≤ M) : fl (asw fl w d) = asw fl w d := by
  unfold asw
  exact h.idem _ (le_trans (le_trans (abs_add_le _ _) (by linarith)) hM)

/-- A gate whose pre-activation is not positive is exactly 0. -/
theorem relu_fl_zero {u η M : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) {x : ℝ} (hx : x ≤ 0)
    (hxM : -M ≤ x) : Lane4.relu (fl x) = 0 := by
  have := h.nonpos hx hxM
  unfold Lane4.relu
  exact max_eq_right this

/-- A candidate is a key that the mask allows and whose gate is exactly 0. -/
theorem AHead.mem_cands (h : AHead) (fl : ℝ → ℝ) (dg : ℕ → ℝ) (dgb : ℝ) (n : ℕ)
    (x : ℕ → Vec) (i j : ℕ) :
    j ∈ h.cands fl dg dgb n x i ↔ j ∈ cand h.mask n i ∧ h.gate fl dg dgb (x j) = 0 := by
  unfold AHead.cands
  rw [List.mem_filter, decide_eq_true_eq]

theorem AHead.cands_nodup (h : AHead) (fl : ℝ → ℝ) (dg : ℕ → ℝ) (dgb : ℝ) (n : ℕ)
    (x : ℕ → Vec) (i : ℕ) : (h.cands fl dg dgb n x i).Nodup :=
  (Lane4.Seq.cand_nodup h.mask n i).filter _

end Lane4.AGate
