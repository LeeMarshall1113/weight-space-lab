/-
Lane 4, rung 5: everything a case file imports (the softmax kit and the binary32 instance),
plus the side conditions used by the two corollaries in every case's Final.lean:
exact arithmetic at every length, and binary32 up to 65,536 positions.
Fixed by the lane. Doctors do not edit this file.
-/
import Lane4.RSoftKit
import Lane4.Bin32

namespace Lane4.Bin32

theorem side_u {n : ℕ} (hn : n ≤ 65536) : (1 : ℝ) / 2 ^ 24 * (n : ℝ) ≤ 1 / 256 := by
  have h1 : (n : ℝ) ≤ 65536 := by exact_mod_cast hn
  norm_num
  linarith

theorem side_eta {n : ℕ} (hn : n ≤ 65536) : (1 : ℝ) / 2 ^ 149 * (n : ℝ) ≤ 1 / 2 ^ 100 := by
  have h1 : (n : ℝ) ≤ 65536 := by exact_mod_cast hn
  have h2 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  have h3 : (1 : ℝ) / 2 ^ 149 * (n : ℝ) ≤ 1 / 2 ^ 149 * 65536 :=
    mul_le_mul_of_nonneg_left h1 (by positivity)
  refine le_trans h3 ?_
  norm_num

theorem eta_le : (1 : ℝ) / 2 ^ 150 ≤ 1 / 2 ^ 149 := by norm_num

/-- A larger underflow term is a weaker model. -/
theorem rnd_weaken {u η η' M : ℝ} {fl : ℝ → ℝ} (h : Lane4.RSoft.Rnd u η M fl) (hη : η ≤ η') :
    Lane4.RSoft.Rnd u η' M fl :=
  ⟨h.M0, fun x hx => le_trans (h.err x hx) (by linarith), h.mono, h.idem, h.nat⟩

/-- Binary32 with the underflow term `2^-149` (twice the rounding bound; the exponential
is given the same room in the subnormal range). -/
theorem bin32_rnd' {rn fl : ℝ → ℝ} (h : IsRN rn) (hfl : ∀ x, |x| ≤ maxF → fl x = rn x) :
    Lane4.RSoft.Rnd (1 / 2 ^ 24) (1 / 2 ^ 149) maxF fl := rnd_weaken (bin32_rnd h hfl) eta_le

end Lane4.Bin32
