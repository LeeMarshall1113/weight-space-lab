theorem absSum_le (r : List ℚ) (W : ℝ) (ha : ∀ a ∈ r, |(a : ℝ)| ≤ W) :
    absSum r ≤ (r.length : ℝ) * W := by
  induction r with
  | nil => simp [absSum]
  | cons a0 r' ih =>
    have hab : absSum (a0 :: r') = |(a0 : ℝ)| + absSum r' := by simp [absSum]
    have h1 := ih (fun b hb => ha b (by simp [hb]))
    have h2 := ha a0 (by simp)
    rw [hab]
    simp only [List.length_cons, Nat.cast_add, Nat.cast_one]
    linarith

theorem absSum_nonneg (r : List ℚ) : 0 ≤ absSum r := by
  induction r with
  | nil => simp [absSum]
  | cons a0 r' ih =>
    have hab : absSum (a0 :: r') = |(a0 : ℝ)| + absSum r' := by simp [absSum]
    rw [hab]
    have := abs_nonneg (a0 : ℝ)
    linarith

