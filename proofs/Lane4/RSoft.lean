/-
Lane 4, rung 5 framework: a transformer with SOFTMAX attention, relatively perturbed
weights, and a forward pass in a floating-point model with underflow.

Fixed by the lane. Doctors do not edit this file.

What changes against RSeq.lean (rung 4):

* The rounding model `Rnd u η M fl`: for `|x| ≤ M`, `|fl x - x| ≤ u * |x| + η` (relative
  error `u` plus an absolute underflow term `η`), monotone, idempotent; exact on the
  integers up to 2^24. NOTHING is assumed for `|x| > M`, so a proof from this model also
  shows that no operation leaves the range. Binary32 round-to-nearest (any tie rule, with
  subnormals) satisfies it with `u = 2^-24`, `η = 2^-150`, `M` = the largest finite
  binary32 number (`Lane4/Bin32.lean`). Exact arithmetic satisfies it with `u = η = 0`
  and any `M` (`rnd_id`).
* The float exponential is NOT fixed by IEEE 754. It enters as a hypothesis `ExpM u η ex`:
  non-negative, `ex 0 = 1`, and for `x ≤ 0` within `4 * u * exp x + η` of the real
  exponential. The real exponential satisfies it with `u = η = 0` (`expM_real`).
* Attention is softmax, in this stated order of operations. For query `i` with candidate
  list `c` (the mask) and scores `s j` (computed as in RSeq: rounded bilinear form):
      m    = the largest score over `c`                     (exact: a maximum of floats)
      e j  = ex (fl (s j - m))
      Z    = e summed over `c`, left to right, every addition rounded
      N_r  = fl (e j * v j r) summed over `c`, left to right, every addition rounded
      out_r = fl (N_r / Z)
  where `v j r = V_r · x_j` (rounded dot product). With no candidate the output is 0.
* Everything else (embedding, stored weights `fl (w * (1 + d))`, position features
  `[1, fl i, fl n]`, residual heads, one-hidden-layer ReLU MLP, read-out) is as in RSeq.

Not modelled: fused multiply-add, reordered or vectorised sums, any exponential worse than the stated bound.
-/
import Lane4.RSeq

namespace Lane4.RSoft

open Lane4.Seq (Mask cand tokAt)
open Lane4.RSeq

/-- The rounding model with underflow, assumed only inside the range `[-M, M]`.
Nothing is assumed about `fl x` for `|x| > M`, so a proof from this model shows in passing
that no operation of the forward pass leaves the range (no overflow). -/
structure Rnd (u η M : ℝ) (fl : ℝ → ℝ) : Prop where
  M0 : 0 ≤ M
  err : ∀ x, |x| ≤ M → |fl x - x| ≤ u * |x| + η
  mono : ∀ x y, |x| ≤ M → |y| ≤ M → x ≤ y → fl x ≤ fl y
  idem : ∀ x, |x| ≤ M → fl (fl x) = fl x
  nat : ∀ k : ℕ, k ≤ 16777216 → fl (k : ℝ) = (k : ℝ)

/-- The model of the float exponential (used only at arguments `≤ 0`). -/
structure ExpM (u η : ℝ) (ex : ℝ → ℝ) : Prop where
  nonneg : ∀ x, 0 ≤ ex x
  zero : ex 0 = 1
  err : ∀ x, x ≤ 0 → |ex x - Real.exp x| ≤ 4 * u * Real.exp x + η

/-- Distance between two positions. -/
def ndist (a b : ℕ) : ℕ := (a - b) + (b - a)

theorem ndist_cast (a b : ℕ) : ((ndist a b : ℕ) : ℝ) = |(a : ℝ) - (b : ℝ)| := by
  unfold ndist
  rcases le_total a b with h | h
  · rw [Nat.sub_eq_zero_of_le h, zero_add, Nat.cast_sub h,
      abs_of_nonpos (by have : (a : ℝ) ≤ b := by exact_mod_cast h
                        linarith)]
    ring
  · rw [Nat.sub_eq_zero_of_le h, add_zero, Nat.cast_sub h,
      abs_of_nonneg (by have : (b : ℝ) ≤ a := by exact_mod_cast h
                        linarith)]

/-! ### Softmax attention -/

/-- The largest score over a candidate list (0 for the empty list). -/
noncomputable def smax (s : ℕ → ℝ) : List ℕ → ℝ
  | [] => 0
  | [j] => s j
  | j :: k :: c => max (s j) (smax s (k :: c))

/-- The unnormalised softmax weight of key `j`. -/
noncomputable def swt (fl ex : ℝ → ℝ) (c : List ℕ) (s : ℕ → ℝ) (j : ℕ) : ℝ :=
  ex (fl (s j - smax s c))

/-- Softmax-weighted average of `f` over the candidates `c` with scores `s`. -/
noncomputable def savg (fl ex : ℝ → ℝ) (c : List ℕ) (s f : ℕ → ℝ) : ℝ :=
  fl (rsum fl (c.map (fun j => fl (swt fl ex c s j * f j))) 0
      / rsum fl (c.map (swt fl ex c s)) 0)

/-- One output entry per row of `V`: the softmax average of `V_r · x_j`. -/
noncomputable def sattnRows (fl ex : ℝ → ℝ) :
    List (List ℚ) → (ℕ → ℕ → ℝ) → List ℕ → (ℕ → ℝ) → (ℕ → Vec) → ℕ → Vec
  | r :: M, dV, c, s, x, i =>
    savg fl ex c s (fun j => rdot fl r (x j) (dV i) 0 0) :: sattnRows fl ex M dV c s x (i + 1)
  | [], _, _, _, _, _ => []

/-- The scores of head `h` for query `i`. -/
noncomputable def hscore (h : Head) (fl : ℝ → ℝ) (dA : ℕ → ℕ → ℝ) (x : ℕ → Vec) (i : ℕ) :
    ℕ → ℝ := fun j => h.score fl dA (x i) (x j)

noncomputable def sattn (h : Head) (fl ex : ℝ → ℝ) (dA dV : ℕ → ℕ → ℝ) (n : ℕ)
    (x : ℕ → Vec) (i : ℕ) : Vec :=
  sattnRows fl ex h.V dV (cand h.mask n i) (hscore h fl dA x i) x 0

/-- Heads `k, k+1, ...` added to `acc` (all heads read the block's input state `x`). -/
noncomputable def sheadsApply (fl ex : ℝ → ℝ) :
    List Head → (ℕ → ℕ → ℕ → ℝ) → (ℕ → ℕ → ℕ → ℝ) → ℕ → (ℕ → Vec) → ℕ → Vec → ℕ → Vec
  | h :: hs, dA, dV, n, x, i, acc, k =>
    sheadsApply fl ex hs dA dV n x i (radd fl acc (sattn h fl ex (dA k) (dV k) n x i)) (k + 1)
  | [], _, _, _, _, _, acc, _ => acc

noncomputable def sblock (B : Block) (fl ex : ℝ → ℝ) (p : Pert) (b n : ℕ) (x : ℕ → Vec) :
    ℕ → Vec := fun i =>
  radd fl (sheadsApply fl ex B.heads (p.A b) (p.V b) n x i (x i) 0)
    (raffine fl B.W2 B.b2
      ((raffine fl B.W1 B.b1 (sheadsApply fl ex B.heads (p.A b) (p.V b) n x i (x i) 0)
        (p.W1 b) (p.b1 b) 0).map relu)
      (p.W2 b) (p.b2 b) 0)

/-- Blocks `b, b+1, ...` applied in order. -/
noncomputable def srunFrom (fl ex : ℝ → ℝ) (p : Pert) (n : ℕ) :
    List Block → ℕ → (ℕ → Vec) → (ℕ → Vec)
  | B :: Bs, b, x => srunFrom fl ex p n Bs (b + 1) (sblock B fl ex p b n x)
  | [], _, x => x

noncomputable def srun (N : TNet) (fl ex : ℝ → ℝ) (p : Pert) (w : List ℕ) : ℕ → Vec :=
  srunFrom fl ex p (w.length + 1) N.blocks 0 (N.init fl p w)

/-- The softmax network's output at position `i` for input `w`. -/
noncomputable def sout (N : TNet) (fl ex : ℝ → ℝ) (p : Pert) (w : List ℕ) (i : ℕ) : ℝ :=
  fl (rdot fl N.outW (srun N fl ex p w i) p.oW 0 0 + sw fl N.outB p.oB)

/-! ### Lemma kit: the rounding model

Every lemma that uses `fl x` asks for a bound `|x| ≤ B` and for `B ≤ M` (the value is in
range). In the statement `M` is at least `2^40 * n^2`; see `range_const`, `range_lin`,
`range_quad` at the end of this section. -/

/-- Exact arithmetic, with any range. -/
theorem rnd_id {M : ℝ} (hM : 0 ≤ M) : Rnd 0 0 M (fun x => x) :=
  ⟨hM, fun x _ => by simp, fun _ _ _ _ h => h, fun _ _ => rfl, fun _ _ => rfl⟩

/-- The real exponential. -/
theorem expM_real : ExpM 0 0 Real.exp :=
  ⟨fun x => (Real.exp_pos x).le, Real.exp_zero, fun x _ => by simp⟩

theorem Rnd.zero {u η M : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) : fl 0 = 0 := by
  simpa using h.nat 0 (by norm_num)

theorem Rnd.one {u η M : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) : fl 1 = 1 := by
  simpa using h.nat 1 (by norm_num)

theorem Rnd.nonneg {u η M : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) {x : ℝ} (hx : 0 ≤ x)
    (hxM : x ≤ M) : 0 ≤ fl x := by
  have h0 : |(0 : ℝ)| ≤ M := by simpa using h.M0
  have hx' : |x| ≤ M := by rwa [abs_of_nonneg hx]
  have := h.mono 0 x h0 hx' hx
  rwa [h.zero] at this

theorem Rnd.nonpos {u η M : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) {x : ℝ} (hx : x ≤ 0)
    (hxM : -M ≤ x) : fl x ≤ 0 := by
  have h0 : |(0 : ℝ)| ≤ M := by simpa using h.M0
  have hx' : |x| ≤ M := by rw [abs_of_nonpos hx]; linarith
  have := h.mono x 0 hx' h0 hx
  rwa [h.zero] at this

/-- `fl x` is within `u * B + η` of `x` when `|x| ≤ B ≤ M`. -/
theorem Rnd.abs {u η M : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) (hu : 0 ≤ u) {x B : ℝ}
    (hx : |x| ≤ B) (hB : B ≤ M) : |fl x - x| ≤ u * B + η :=
  le_trans (h.err x (le_trans hx hB)) (by nlinarith [mul_le_mul_of_nonneg_left hx hu])

theorem Rnd.upper {u η M : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) (hu : 0 ≤ u) {x B : ℝ}
    (hx : |x| ≤ B) (hB : B ≤ M) : fl x ≤ x + (u * B + η) := by
  have := (abs_le.mp (h.abs hu hx hB)).2
  linarith

theorem Rnd.lower {u η M : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) (hu : 0 ≤ u) {x B : ℝ}
    (hx : |x| ≤ B) (hB : B ≤ M) : x - (u * B + η) ≤ fl x := by
  have := (abs_le.mp (h.abs hu hx hB)).1
  linarith

/-- Rounding a value that is within `e` of `t`: the error grows by `u * B + η`. -/
theorem Rnd.near {u η M : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) (hu : 0 ≤ u) {x t e B : ℝ}
    (hx : |x - t| ≤ e) (hB : |x| ≤ B) (hBM : B ≤ M) : |fl x - t| ≤ e + (u * B + η) := by
  have h1 := h.abs hu hB hBM
  have h2 := abs_add_le (fl x - x) (x - t)
  have h3 : fl x - x + (x - t) = fl x - t := by ring
  rw [h3] at h2
  linarith

/-- A bound on the rounded value: `|fl x| ≤ B + (u * B + η)`. -/
theorem Rnd.bound {u η M : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) (hu : 0 ≤ u) {x B : ℝ}
    (hx : |x| ≤ B) (hB : B ≤ M) : |fl x| ≤ B + (u * B + η) := by
  have h1 := h.abs hu hx hB
  have h2 := abs_add_le (fl x - x) x
  have h3 : fl x - x + x = fl x := by ring
  rw [h3] at h2
  linarith

/-- Two values that are far enough apart stay in order after rounding. -/
theorem Rnd.lt_of_gap {u η M : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) (hu : 0 ≤ u)
    {a b B : ℝ} (ha : |a| ≤ B) (hb : |b| ≤ B) (hB : B ≤ M)
    (hgap : a + 2 * (u * B + η) < b) : fl a < fl b := by
  have h1 := h.upper hu ha hB
  have h2 := h.lower hu hb hB
  linarith

/-- The gap between two rounded values. -/
theorem Rnd.gap {u η M : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) (hu : 0 ≤ u)
    {a b B : ℝ} (ha : |a| ≤ B) (hb : |b| ≤ B) (hB : B ≤ M) :
    fl a ≤ fl b - (b - a) + 2 * (u * B + η) := by
  have h1 := h.upper hu ha hB
  have h2 := h.lower hu hb hB
  linarith

/-- The underflow term is far below anything that matters. -/
theorem eta_tiny {η : ℝ} (hη : η ≤ 1 / 2 ^ 149) : η ≤ 1 / 10 ^ 40 := by
  refine le_trans hη ?_
  rw [div_le_div_iff₀ (by positivity) (by positivity)]
  norm_num

/-- Range conditions from the statement's `2^40 * n^2 ≤ M` (with `1 ≤ n`). -/
theorem range_quad {M c : ℝ} {n : ℕ} (hM : 2 ^ 40 * (n : ℝ) ^ 2 ≤ M)
    (hc : c ≤ 2 ^ 40) : c * (n : ℝ) ^ 2 ≤ M :=
  le_trans (mul_le_mul_of_nonneg_right hc (by positivity)) hM

theorem range_lin {M c : ℝ} {n : ℕ} (hM : 2 ^ 40 * (n : ℝ) ^ 2 ≤ M) (hn : 1 ≤ n)
    (hc0 : 0 ≤ c) (hc : c ≤ 2 ^ 40) : c * (n : ℝ) ≤ M := by
  have h1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have h2 : c * (n : ℝ) ≤ c * (n : ℝ) ^ 2 := by
    have : (n : ℝ) ≤ (n : ℝ) ^ 2 := by nlinarith
    exact mul_le_mul_of_nonneg_left this hc0
  exact le_trans h2 (range_quad hM hc)

theorem range_const {M c : ℝ} {n : ℕ} (hM : 2 ^ 40 * (n : ℝ) ^ 2 ≤ M) (hn : 1 ≤ n)
    (hc : c ≤ 2 ^ 40) : c ≤ M := by
  have h1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have h2 : (1 : ℝ) ≤ (n : ℝ) ^ 2 := by nlinarith
  have h3 : (2 : ℝ) ^ 40 ≤ 2 ^ 40 * (n : ℝ) ^ 2 := by nlinarith
  linarith

/-! ### Lemma kit: stored weights and products -/

theorem sw_zero {u η M : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) (d : ℝ) : sw fl 0 d = 0 := by
  simp [sw, h.zero]

/-- A stored weight is within `ε * |w| + η` of the written weight, for any
`ε ≥ τ + u + u * τ`. Range condition: `2 * |w| ≤ M` (and `τ ≤ 1`). -/
theorem sw_near {u η M τ ε : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) (hu : 0 ≤ u) (w : ℚ) {d : ℝ}
    (hd : |d| ≤ τ) (hτ1 : τ ≤ 1) (hwM : 2 * |(w : ℝ)| ≤ M) (hε : τ + u + u * τ ≤ ε) :
    |sw fl w d - (w : ℝ)| ≤ ε * |(w : ℝ)| + η := by
  unfold sw
  have hτ : 0 ≤ τ := le_trans (abs_nonneg d) hd
  have h1 : |(w : ℝ) * (1 + d)| ≤ |(w : ℝ)| * (1 + τ) := by
    rw [abs_mul]
    apply mul_le_mul_of_nonneg_left _ (abs_nonneg _)
    have := abs_add_le (1 : ℝ) d
    simp only [abs_one] at this
    linarith
  have hr : |(w : ℝ)| * (1 + τ) ≤ M := by nlinarith [abs_nonneg (w : ℝ)]
  have h2 := h.abs hu h1 hr
  have h3 : |(w : ℝ) * (1 + d) - (w : ℝ)| ≤ τ * |(w : ℝ)| := by
    have : (w : ℝ) * (1 + d) - (w : ℝ) = d * (w : ℝ) := by ring
    rw [this, abs_mul]
    exact mul_le_mul_of_nonneg_right hd (abs_nonneg _)
  have h4 := abs_add_le (fl ((w : ℝ) * (1 + d)) - (w : ℝ) * (1 + d)) ((w : ℝ) * (1 + d) - (w : ℝ))
  have h5 : fl ((w : ℝ) * (1 + d)) - (w : ℝ) * (1 + d) + ((w : ℝ) * (1 + d) - (w : ℝ))
      = fl ((w : ℝ) * (1 + d)) - (w : ℝ) := by ring
  rw [h5] at h4
  have h6 := mul_le_mul_of_nonneg_right hε (abs_nonneg (w : ℝ))
  nlinarith [h2, h3, h4, h6, abs_nonneg (w : ℝ)]

/-- A stored weight is unchanged by rounding it again. -/
theorem fl_sw {u η M τ : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) (w : ℚ) {d : ℝ}
    (hd : |d| ≤ τ) (hτ1 : τ ≤ 1) (hwM : 2 * |(w : ℝ)| ≤ M) : fl (sw fl w d) = sw fl w d := by
  unfold sw
  apply h.idem
  rw [abs_mul]
  have h1 : |1 + d| ≤ 2 := by
    have := abs_add_le (1 : ℝ) d
    simp only [abs_one] at this
    linarith
  nlinarith [abs_nonneg (w : ℝ), abs_nonneg (1 + d)]

/-- Product of two approximations (absolute errors `a`, `b`). -/
theorem mul_near {x y s t a b : ℝ} (hx : |x - s| ≤ a) (hy : |y - t| ≤ b) :
    |x * y - s * t| ≤ a * |t| + b * |s| + a * b := by
  have h : x * y - s * t = (x - s) * (y - t) + (x - s) * t + s * (y - t) := by ring
  have h1 : |(x - s) * (y - t)| ≤ a * b := by
    rw [abs_mul]
    exact mul_le_mul hx hy (abs_nonneg _) (le_trans (abs_nonneg _) hx)
  have h2 : |(x - s) * t| ≤ a * |t| := by
    rw [abs_mul]
    exact mul_le_mul_of_nonneg_right hx (abs_nonneg _)
  have h3 : |s * (y - t)| ≤ b * |s| := by
    rw [abs_mul, mul_comm]
    exact mul_le_mul_of_nonneg_right hy (abs_nonneg _)
  have h4 := abs_add_le ((x - s) * (y - t) + (x - s) * t) (s * (y - t))
  have h5 := abs_add_le ((x - s) * (y - t)) ((x - s) * t)
  rw [h]
  linarith

/-! ### Lemma kit: rounded positions

`n` is the number of positions; `u * n ≤ 1/256`, `η ≤ 1/2^149` and `n ≤ M` come from the
statement (the last through `range_lin`). -/

theorem Rnd.natCast_near {u η M : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) (k : ℕ)
    (hk : (k : ℝ) ≤ M) : |fl (k : ℝ) - k| ≤ u * k + η := by
  have h2 : |(k : ℝ)| = k := abs_of_nonneg (Nat.cast_nonneg k)
  have h3 : |(k : ℝ)| ≤ M := by rw [h2]; exact hk
  have := h.err (k : ℝ) h3
  rw [h2] at this
  exact this

/-- Rounded positions stay in order, almost as far apart as the positions. -/
theorem Rnd.pos_gap {u η M : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) (hu : 0 ≤ u)
    (hη : η ≤ 1 / 2 ^ 149) {a b n : ℕ} (hab : a ≤ b) (hbn : b ≤ n)
    (hn : u * (n : ℝ) ≤ 1 / 256) (hnM : (n : ℝ) ≤ M) :
    fl (a : ℝ) + ((b : ℝ) - a) - 1 / 100 ≤ fl (b : ℝ) := by
  have h1 : (a : ℝ) ≤ b := by exact_mod_cast hab
  have h2 : (b : ℝ) ≤ n := by exact_mod_cast hbn
  have ha := abs_le.mp (h.natCast_near a (by linarith))
  have hb := abs_le.mp (h.natCast_near b (by linarith))
  have h3 : u * (a : ℝ) ≤ u * n := mul_le_mul_of_nonneg_left (by linarith) hu
  have h4 : u * (b : ℝ) ≤ u * n := mul_le_mul_of_nonneg_left h2 hu
  have h5 := eta_tiny hη
  have h6 : (1 : ℝ) / 10 ^ 40 ≤ 1 / 1000 := by norm_num
  linarith

/-- A rounded position is between 0 and `n + 1/100`. -/
theorem Rnd.pos_le {u η M : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) (hu : 0 ≤ u)
    (hη : η ≤ 1 / 2 ^ 149) {k n : ℕ} (hk : k ≤ n) (hn : u * (n : ℝ) ≤ 1 / 256)
    (hnM : (n : ℝ) ≤ M) : 0 ≤ fl (k : ℝ) ∧ fl (k : ℝ) ≤ n + 1 / 100 := by
  have h2 : (k : ℝ) ≤ n := by exact_mod_cast hk
  have hb := abs_le.mp (h.natCast_near k (by linarith))
  have h4 : u * (k : ℝ) ≤ u * n := mul_le_mul_of_nonneg_left h2 hu
  have h5 := eta_tiny hη
  have h6 : (1 : ℝ) / 10 ^ 40 ≤ 1 / 1000 := by norm_num
  exact ⟨h.nonneg (Nat.cast_nonneg k) (by linarith), by linarith⟩

/-- A rounded position is close to the position. -/
theorem Rnd.pos_near {u η M : ℝ} {fl : ℝ → ℝ} (h : Rnd u η M fl) (hu : 0 ≤ u)
    (hη : η ≤ 1 / 2 ^ 149) {k n : ℕ} (hk : k ≤ n) (hn : u * (n : ℝ) ≤ 1 / 256)
    (hnM : (n : ℝ) ≤ M) : |fl (k : ℝ) - k| ≤ 1 / 200 := by
  have h2 : (k : ℝ) ≤ n := by exact_mod_cast hk
  have hb := h.natCast_near k (by linarith)
  have h4 : u * (k : ℝ) ≤ u * n := mul_le_mul_of_nonneg_left h2 hu
  have h5 := eta_tiny hη
  have h6 : (1 : ℝ) / 10 ^ 40 ≤ 1 / 1000 := by norm_num
  linarith

/-! ### Lemma kit: softmax

The main lemmas `savg_near` and `savg_zeros` are in `Lane4/RSoftKit.lean`. -/

theorem smax_ge (s : ℕ → ℝ) : ∀ (c : List ℕ) (k : ℕ), k ∈ c → s k ≤ smax s c
  | [], _, h => by simp at h
  | [j], k, h => by
    simp only [List.mem_singleton] at h
    simp [smax, h]
  | j :: k' :: c, k, h => by
    simp only [smax]
    rcases List.mem_cons.mp h with h | h
    · rw [h]; exact le_max_left _ _
    · exact le_trans (smax_ge s (k' :: c) k h) (le_max_right _ _)

theorem smax_mem (s : ℕ → ℝ) : ∀ (c : List ℕ), c ≠ [] → ∃ k ∈ c, smax s c = s k
  | [], h => absurd rfl h
  | [j], _ => ⟨j, by simp, rfl⟩
  | j :: k' :: c, _ => by
    obtain ⟨k, hk, hs⟩ := smax_mem s (k' :: c) (by simp)
    simp only [smax]
    rcases le_total (s j) (smax s (k' :: c)) with h | h
    · exact ⟨k, List.mem_cons_of_mem _ hk, by rw [max_eq_right h, hs]⟩
    · exact ⟨j, by simp, by rw [max_eq_left h]⟩

/-- If key `j` has the largest score, the maximum is its score. -/
theorem smax_eq (s : ℕ → ℝ) (c : List ℕ) (j : ℕ) (hj : j ∈ c) (h : ∀ k ∈ c, s k ≤ s j) :
    smax s c = s j := by
  apply le_antisymm
  · obtain ⟨k, hk, hs⟩ := smax_mem s c (List.ne_nil_of_mem hj)
    rw [hs]
    exact h k hk
  · exact smax_ge s c j hj

/-- The key with the largest score has softmax weight exactly 1. -/
theorem swt_winner {u η M : ℝ} {fl ex : ℝ → ℝ} (hr : Rnd u η M fl) (he : ExpM u η ex)
    (s : ℕ → ℝ) (c : List ℕ) (j : ℕ) (hj : j ∈ c) (h : ∀ k ∈ c, s k ≤ s j) :
    swt fl ex c s j = 1 := by
  simp [swt, smax_eq s c j hj h, hr.zero, he.zero]

end Lane4.RSoft
