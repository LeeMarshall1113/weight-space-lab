theorem sum_ge_mem' (c : List ℕ) (f : ℕ → ℝ) (hf : ∀ k, 0 ≤ f k) (p : ℕ) (hp : p ∈ c) :
    f p ≤ (c.map f).sum := by
  induction c with
  | nil => simp at hp
  | cons a c ih =>
    rw [List.map_cons, List.sum_cons]
    have hnn : 0 ≤ (c.map f).sum :=
      List.sum_nonneg (by
        intro x hx
        obtain ⟨k, _, rfl⟩ := List.mem_map.mp hx
        exact hf k)
    rcases List.mem_cons.mp hp with h | h
    · rw [h]; linarith
    · have := ih h
      linarith [hf a]

