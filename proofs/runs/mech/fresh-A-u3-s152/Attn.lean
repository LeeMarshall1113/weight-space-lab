namespace Lane4.NetA
open Lane4.Case Lane4.Cert Lane4.Cert8 Lane4.AGate Lane4.RSoft Lane4.Bin32

/-- The registered task-A automaton of rung 8 (state: the previous digit). -/
def task : Task :=
  { ntok := 5, init := 0,
    step := fun _ t => t - 1,
    out := fun s t => ((t - 1) + s) % 5 }

theorem fold_last (w : List ℕ) (k : ℕ) (hk : k < w.length) :
    (w.take (k + 1)).foldl (fun _ t => t - 1) 0 = w.getD k 0 - 1 := by
  rw [List.take_succ_eq_append_getElem hk, List.foldl_append]
  simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hk]

theorem target_eq (w : List ℕ) (i : ℕ) (h1 : 1 ≤ i) (h2 : i ≤ w.length) :
    task.target w i = target w i := by
  by_cases h : 2 ≤ i
  · obtain ⟨k, rfl⟩ : ∃ k, i = k + 2 := ⟨i - 2, by omega⟩
    have e := fold_last w k (by omega)
    show ((w.getD (k + 2 - 1) 0 - 1) + (w.take (k + 2 - 1)).foldl (fun _ t => t - 1) 0) % 5
      = ((w.getD (k + 2 - 1) 0 - 1) + (if 2 ≤ k + 2 then w.getD (k + 2 - 2) 0 - 1 else 0)) % 5
    rw [if_pos h,show k + 2 - 1 = k + 1 from rfl, show k + 2 - 2 = k from rfl, e]
  · have hi : i = 1 := by omega
    subst hi
    show ((w.getD (1 - 1) 0 - 1) + (w.take (1 - 1)).foldl (fun _ t => t - 1) 0) % 5
      = ((w.getD (1 - 1) 0 - 1) + (if 2 ≤ 1 then w.getD (1 - 2) 0 - 1 else 0)) % 5
    simp

end Lane4.NetA

namespace Lane4.Net
open Lane4.Case Lane4.Cert

theorem bis : Lane4.Mech.bisimOK prog Lane4.NetA.task [(0, 0), (1, 1), (2, 2), (3, 3), (4, 4)] = true := by decide +kernel

/-- THE EXTRACTED PROGRAM IS THE TASK: on every valid input, at every position. -/
theorem prog_is_task (w : List ℕ) (hw : ∀ t ∈ w, 1 ≤ t ∧ t ≤ 5) (i : ℕ) (h1 : 1 ≤ i) (h2 : i ≤ w.length) :
    ptarget w i = target w i := by
  have h := Lane4.Mech.bisim_sound prog Lane4.NetA.task _ bis w hw i h1 h2
  rw [Lane4.NetA.target_eq w i h1 h2] at h
  exact h

end Lane4.Net

