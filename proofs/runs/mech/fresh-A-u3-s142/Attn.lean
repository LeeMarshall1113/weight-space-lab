namespace Lane4.Net
open Lane4.Case Lane4.Cert Lane4.Cert8 Lane4.AGate Lane4.RSoft
open Lane4.Seq (Mask cand tokAt)
open Lane4.RSeq (Vec)

/-- ATTENTION WINDOW for this network (row (a)): in every network of the ball, on every input, at every
position, each head puts all but `3 * tailB` of its softmax weight on a window `P` of at most `L + 1`
of its latest positions. Weights: exact softmax of the scores the network computes. -/
theorem attn_window :
    ∀ (u η M : ℝ) (fl : ℝ → ℝ), Rnd u η M fl →
    0 ≤ u → u ≤ 1 / 2 ^ 24 → 0 ≤ η → η ≤ 1 / 2 ^ 149 →
    ∀ p : APert, p.Within (((1/16384 : ℚ)) : ℝ) →
    ∀ w : List ℕ, (∀ t ∈ w, 1 ≤ t ∧ t ≤ task.ntok) →
    u * ((w.length + 1 : ℕ) : ℝ) ≤ 1 / 256 → η * ((w.length + 1 : ℕ) : ℝ) ≤ 1 / 2 ^ 100 →
    2 ^ 40 * ((w.length + 1 : ℕ) : ℝ) ^ 2 ≤ M →
    ∀ (B : ABlock), net.blocks = [B] →
    ∀ (a : ℕ) (h : AHead) (hc : HCert), a < B.heads.length →
    B.heads.getD a h = h → cert.heads.getD a hc = hc →
    ∀ i : ℕ, 1 ≤ i → i ≤ w.length →
    ∃ P : List ℕ, WinPos h.mask hc.cands (tokAt w) (w.length + 1) i P ∧ P.length ≤ hc.L + 1 ∧
      (((h.cands fl (p.g 0 a) (p.gb 0 a) (w.length + 1) (net.init fl p w) i).filter
          (fun k => decide (k ∉ P))).map
          (fun k => Real.exp (h.score fl (p.A 0 a) (p.m 0 a) (net.init fl p w) i k))).sum
        ≤ ((3 * tailB (1/16384) h hc : ℚ) : ℝ) *
          ((h.cands fl (p.g 0 a) (p.gb 0 a) (w.length + 1) (net.init fl p w) i).map
            (fun k => Real.exp (h.score fl (p.A 0 a) (p.m 0 a) (net.init fl p w) i k))).sum :=
  Lane4.Case.attn_window8 (1/16384) net task cert accept

theorem attn_eps0 : 3 * tailB (1/16384) netH0 hc0 ≤ 1 / 2 ^ 21 := by decide +kernel
theorem attn_L0 : hc0.L = 1 := by decide +kernel
theorem attn_eps1 : 3 * tailB (1/16384) netH1 hc1 ≤ 1 / 2 ^ 21 := by decide +kernel
theorem attn_L1 : hc1.L = 2 := by decide +kernel

end Lane4.Net
