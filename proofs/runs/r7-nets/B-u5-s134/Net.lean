namespace Lane4.Net
open Lane4.Case Lane4.Cert Lane4.AGate Lane4.RSoft Lane4.Bin32
open Lane4.Seq (Mask cand tokAt)
set_option maxRecDepth 1000000
set_option maxHeartbeats 0

def task : Task :=
  { ntok := 5, init := 0,
    step := fun c t => if cls t = 2 then c else cls t,
    out := fun s t => (dg t + s) % 3 }

def cd0 : List Bool := [true, true, true, false, true, true]
def cd1 : List Bool := [true, false, true, false, false, false]
def s0 : ℕ × List (Option ℕ) := (0, [some 0, some 0])
def s1 : ℕ × List (Option ℕ) := (0, [some 1, some 0])
def s2 : ℕ × List (Option ℕ) := (1, [some 2, some 2])
def s3 : ℕ × List (Option ℕ) := (0, [some 4, some 0])
def s4 : ℕ × List (Option ℕ) := (0, [some 5, some 0])
def s5 : ℕ × List (Option ℕ) := (0, [some 1, some 2])
def s6 : ℕ × List (Option ℕ) := (0, [some 4, some 2])
def s7 : ℕ × List (Option ℕ) := (0, [some 5, some 2])
def cert : Cert :=
  { cands := [cd0, cd1],
    states := [s0, s1, s2, s3, s4, s5, s6, s7] }
abbrev E : List (List IV) := net.embed.map (embIV (1/1000))

theorem shape : net.shapeOK task.ntok = true := by decide +kernel
theorem wts : weightsOK net netB0 = true := by decide +kernel
theorem len : (cert.cands.length == netB0.heads.length) = true := by decide +kernel
theorem stl : cert.states.all (fun st => st.2.length == netB0.heads.length) = true := by decide +kernel
theorem ini : cert.states.contains (task.init, cert.cands.map (fun cd => if cd.getD 0 false = true then some 0 else none)) = true := by decide +kernel
theorem hd0 : headOK (1 / 1000) E netH0 cd0 = true := by decide +kernel
theorem hd1 : headOK (1 / 1000) E netH1 cd1 = true := by decide +kernel
theorem st0 : (List.range task.ntok).all (fun k => caseOK (1 / 1000) net netB0 task cert E s0 (k + 1)) = true := by decide +kernel
theorem st1 : (List.range task.ntok).all (fun k => caseOK (1 / 1000) net netB0 task cert E s1 (k + 1)) = true := by decide +kernel
theorem st2 : (List.range task.ntok).all (fun k => caseOK (1 / 1000) net netB0 task cert E s2 (k + 1)) = true := by decide +kernel
theorem st3 : (List.range task.ntok).all (fun k => caseOK (1 / 1000) net netB0 task cert E s3 (k + 1)) = true := by decide +kernel
theorem st4 : (List.range task.ntok).all (fun k => caseOK (1 / 1000) net netB0 task cert E s4 (k + 1)) = true := by decide +kernel
theorem st5 : (List.range task.ntok).all (fun k => caseOK (1 / 1000) net netB0 task cert E s5 (k + 1)) = true := by decide +kernel
theorem st6 : (List.range task.ntok).all (fun k => caseOK (1 / 1000) net netB0 task cert E s6 (k + 1)) = true := by decide +kernel
theorem st7 : (List.range task.ntok).all (fun k => caseOK (1 / 1000) net netB0 task cert E s7 (k + 1)) = true := by decide +kernel

/-- THE CHECKER ACCEPTS: every conjunct evaluated by the kernel above, put together by
`check_of` (Lane4/R7Glue.lean) without further evaluation. -/
theorem accept : check (1 / 1000) net task cert = true :=
  check_of (1 / 1000) net task cert netB0 rfl shape wts len
    (heads_cons _ _ _ _ _ hd0 (heads_cons _ _ _ _ _ hd1 (heads_nil _))) stl ini
    (all_cons_of _ _ _ st0 (all_cons_of _ _ _ st1 (all_cons_of _ _ _ st2 (all_cons_of _ _ _ st3 (all_cons_of _ _ _ st4 (all_cons_of _ _ _ st5 (all_cons_of _ _ _ st6 (all_cons_of _ _ _ st7 (all_nil_of _)))))))))

theorem target_eq (w : List ℕ) (i : ℕ) : task.target w i = target w i := rfl

/-- The registered statement for the skeleton `net` (the trained weights rounded to multiples of
1/1024): every network within the additive 1/1000 ball, every length the rounding model covers. -/
theorem skeleton_ok : Statement net := by
  have s := Lane4.R7K5.sound
  unfold Lane4.Cert.Sound at s
  intro u η M fl ex hr he hu0 hu hη0 hη p hp w hw h1 h2 h3 i hi1 hi2
  have h := s net task cert accept u η M fl ex hr he hu0 hu hη0 hη p hp w hw h1 h2 h3 i hi1 hi2
  rw [target_eq] at h
  exact h

theorem exact_all_lengths (p : APert) (hp : p.Within (1 / 1000)) (w : List ℕ)
    (hw : ∀ t ∈ w, 1 ≤ t ∧ t ≤ 5) (i : ℕ) (h1 : 1 ≤ i) (h2 : i ≤ w.length) :
    |ANet.out net (fun x => x) Real.exp p w i - ((target w i : ℕ) : ℝ)| ≤ 1 / 4 :=
  skeleton_ok 0 0 (2 ^ 40 * ((w.length + 1 : ℕ) : ℝ) ^ 2) (fun x => x) Real.exp
    (rnd_id (by positivity)) expM_real le_rfl (by positivity) le_rfl (by positivity)
    p hp w hw (by simp) (by simp) le_rfl i h1 h2

theorem binary32 (rn fl ex : ℝ → ℝ) (hrn : IsRN rn) (hfl : ∀ x, |x| ≤ maxF → fl x = rn x)
    (hex : ExpM (1 / 2 ^ 24) (1 / 2 ^ 149) ex) (p : APert) (hp : p.Within (1 / 1000))
    (w : List ℕ) (hw : ∀ t ∈ w, 1 ≤ t ∧ t ≤ 5) (hlen : w.length + 1 ≤ 65536)
    (i : ℕ) (h1 : 1 ≤ i) (h2 : i ≤ w.length) :
    |ANet.out net fl ex p w i - ((target w i : ℕ) : ℝ)| ≤ 1 / 4 :=
  skeleton_ok (1 / 2 ^ 24) (1 / 2 ^ 149) maxF fl ex (bin32_rnd' hrn hfl) hex (by positivity) le_rfl
    (by positivity) le_rfl p hp w hw (side_u hlen) (side_eta hlen) (range_ok hlen) i h1 h2

