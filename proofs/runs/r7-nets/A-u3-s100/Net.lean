/-- Target at position `i`: (digit of token `i` + digit of token `i - 1`) mod 5; token `t` is
digit `t - 1`; before position 1 the digit is 0. -/
def target (w : List ℕ) (i : ℕ) : ℕ :=
  ((w.getD (i - 1) 0 - 1) + (if 2 ≤ i then w.getD (i - 2) 0 - 1 else 0)) % 5

