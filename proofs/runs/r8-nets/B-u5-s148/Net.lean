theorem st6 : (List.range task.ntok).all (fun k => caseOK8 (1/16384) net netB0 task cert s6 (k + 1)) = true := by decide +kernel
theorem st7 : (List.range task.ntok).all (fun k => caseOK8 (1/16384) net netB0 task cert s7 (k + 1)) = true := by decide +kernel
theorem st8 : (List.range task.ntok).all (fun k => caseOK8 (1/16384) net netB0 task cert s8 (k + 1)) = true := by decide +kernel
theorem st9 : (List.range task.ntok).all (fun k => caseOK8 (1/16384) net netB0 task cert s9 (k + 1)) = true := by decide +kernel
theorem st10 : (List.range task.ntok).all (fun k => caseOK8 (1/16384) net netB0 task cert s10 (k + 1)) = true := by decide +kernel
theorem st11 : (List.range task.ntok).all (fun k => caseOK8 (1/16384) net netB0 task cert s11 (k + 1)) = true := by decide +kernel
theorem st12 : (List.range task.ntok).all (fun k => caseOK8 (1/16384) net netB0 task cert s12 (k + 1)) = true := by decide +kernel

/-- THE CHECKER ACCEPTS: every conjunct evaluated by the kernel above, put together by `check8_of`. -/
theorem accept : check8 (1/16384) net task cert = true :=
  check8_of (1/16384) net task cert netB0 rfl rd0 rd1 shape wts len
    (heads_cons _ _ _ _ _ hd0 (heads_cons _ _ _ _ _ hd1 (heads_nil _))) stl ini
    (all_cons_of _ _ _ st0 (all_cons_of _ _ _ st1 (all_cons_of _ _ _ st2 (all_cons_of _ _ _ st3 (all_cons_of _ _ _ st4 (all_cons_of _ _ _ st5 (all_cons_of _ _ _ st6 (all_cons_of _ _ _ st7 (all_cons_of _ _ _ st8 (all_cons_of _ _ _ st9 (all_cons_of _ _ _ st10 (all_cons_of _ _ _ st11 (all_cons_of _ _ _ st12 (all_nil_of _))))))))))))))

theorem target_eq (w : List ℕ) (i : ℕ) (_h1 : 1 ≤ i) (_h2 : i ≤ w.length) :
    task.target w i = target w i := rfl

theorem rad_cast : (((1/16384 : ℚ)) : ℝ) = 1/16384 := by norm_num

/-- The registered statement for the skeleton `net`: every network within the additive ball of
radius 1/16384, every length the rounding model covers. -/
theorem skeleton_ok : Statement net := by
  have s := Lane4.R8K.sound8
  unfold Lane4.Cert8.Sound8 at s
  intro u η M fl ex hr he hu0 hu hη0 hη p hp w hw h1 h2 h3 i hi1 hi2
  have hp' : p.Within (((1/16384 : ℚ)) : ℝ) := by rw [rad_cast]; exact hp
  have h := s (1/16384) net task cert accept u η M fl ex hr he hu0 hu hη0 hη p hp' w hw h1 h2 h3 i hi1 hi2
  rw [target_eq w i hi1 hi2] at h
  exact h

theorem exact_all_lengths (p : APert) (hp : p.Within (1/16384)) (w : List ℕ)
    (hw : ∀ t ∈ w, 1 ≤ t ∧ t ≤ 5) (i : ℕ) (h1 : 1 ≤ i) (h2 : i ≤ w.length) :
    |ANet.out net (fun x => x) Real.exp p w i - ((target w i : ℕ) : ℝ)| ≤ 1 / 4 :=
  skeleton_ok 0 0 (2 ^ 40 * ((w.length + 1 : ℕ) : ℝ) ^ 2) (fun x => x) Real.exp
    (rnd_id (by positivity)) expM_real le_rfl (by positivity) le_rfl (by positivity)
    p hp w hw (by simp) (by simp) le_rfl i h1 h2

theorem binary32 (rn fl ex : ℝ → ℝ) (hrn : IsRN rn) (hfl : ∀ x, |x| ≤ maxF → fl x = rn x)
    (hex : ExpM (1 / 2 ^ 24) (1 / 2 ^ 149) ex) (p : APert) (hp : p.Within (1/16384))
    (w : List ℕ) (hw : ∀ t ∈ w, 1 ≤ t ∧ t ≤ 5) (hlen : w.length + 1 ≤ 65536)
    (i : ℕ) (h1 : 1 ≤ i) (h2 : i ≤ w.length) :
    |ANet.out net fl ex p w i - ((target w i : ℕ) : ℝ)| ≤ 1 / 4 :=
  skeleton_ok (1 / 2 ^ 24) (1 / 2 ^ 149) maxF fl ex (bin32_rnd' hrn hfl) hex (by positivity) le_rfl
    (by positivity) le_rfl p hp w hw (side_u hlen) (side_eta hlen) (range_ok hlen) i h1 h2

/-! The network exactly as trained. -/

theorem same : Lane4.R7KT.sameShape net trained = true := by decide +kernel
theorem near : Lane4.R7KT.nearNet (1/16384) net trained = true := by decide +kernel

theorem trained_in_ball : (Lane4.R7KT.diffP net trained).Within (1/16384) := by
  have d := Lane4.R7KT.diff_within
  unfold Lane4.R7KT.DiffWithin at d
  have h := d net trained (1/16384) (by norm_num) same near
  rwa [rad_cast] at h

theorem shift (fl ex : ℝ → ℝ) (w : List ℕ) (i : ℕ) :
    ANet.out net fl ex (Lane4.R7KT.diffP net trained) w i
      = ANet.out trained fl ex Lane4.R7KT.zeroP w i := by
  have o := Lane4.R7KT.out_shift
  unfold Lane4.R7KT.OutShift at o
  exact o net trained same fl ex w i

/-- THE HEADLINE: the network AS TRAINED (float32 weights, no rounding of weights, no
perturbation), exact real arithmetic, every input length. -/
theorem trained_exact_all_lengths (w : List ℕ) (hw : ∀ t ∈ w, 1 ≤ t ∧ t ≤ 5) (i : ℕ)
    (h1 : 1 ≤ i) (h2 : i ≤ w.length) :
    |ANet.out trained (fun x => x) Real.exp Lane4.R7KT.zeroP w i - ((target w i : ℕ) : ℝ)| ≤ 1 / 4 := by
  rw [← shift]
  exact exact_all_lengths _ trained_in_ball w hw i h1 h2

/-- The network AS TRAINED, binary32 arithmetic, at most 65,535 input tokens. -/
theorem trained_binary32 (rn fl ex : ℝ → ℝ) (hrn : IsRN rn) (hfl : ∀ x, |x| ≤ maxF → fl x = rn x)
    (hex : ExpM (1 / 2 ^ 24) (1 / 2 ^ 149) ex)
    (w : List ℕ) (hw : ∀ t ∈ w, 1 ≤ t ∧ t ≤ 5) (hlen : w.length + 1 ≤ 65536)
    (i : ℕ) (h1 : 1 ≤ i) (h2 : i ≤ w.length) :
    |ANet.out trained fl ex Lane4.R7KT.zeroP w i - ((target w i : ℕ) : ℝ)| ≤ 1 / 4 := by
  rw [← shift]
  exact binary32 rn fl ex hrn hfl hex _ trained_in_ball w hw hlen i h1 h2


