theorem stl : cert.states.all (fun st => st.2.length == netB0.heads.length) = true := by decide +kernel
theorem ini : cert.states.contains (task.init, cert.heads.map (fun hc => if hc.cands.getD 0 false = true then [0] else [])) = true := by decide +kernel
theorem hd0 : headOK8 (1/16384) E netH0 hc0 = true := by decide +kernel
theorem hd1 : headOK8 (1/16384) E netH1 hc1 = true := by decide +kernel
theorem st0 : (List.range task.ntok).all (fun k => caseOK8 (1/16384) net netB0 task cert s0 (k + 1)) = true := by decide +kernel
