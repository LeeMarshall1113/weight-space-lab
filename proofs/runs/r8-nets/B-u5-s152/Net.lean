def cert : Cert8 :=
  { heads := [hc0, hc1],
    states := [s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20] }
abbrev E : List (List IV) := net.embed.map (embIV (1/16384))

theorem rd0 : decide ((0 : ℚ) ≤ 1/16384) = true := by decide +kernel
theorem rd1 : decide ((1/16384 : ℚ) ≤ 1 / 2) = true := by decide +kernel
theorem shape : net.shapeOK task.ntok = true := by decide +kernel
